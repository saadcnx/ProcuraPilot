{
  "version": 2,
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}